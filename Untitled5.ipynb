      },
      "source": [
        "# Affichage explicite des nombres de lignes\n",
        "nb_entrainement = X_train.shape[0]\n",
        "nb_verification = X_test.shape[0]\n",
        "\n",
        "print(f\"Nombre de lignes utilisées pour l'entraînement : {nb_entrainement}\")\n",
        "print(f\"Nombre de lignes gardées pour la vérification finale : {nb_verification}\")"
