        "from Bio.Seq import Seq\n",
        "from Bio import SeqIO\n",
        "import os\n",
        "\n",
        "# Recherche de fichiers de séquences biologiques (FASTA, GenBank, etc.) dans les fichiers extraits\n",
        "bio_files = []\n",
        "for root, dirs, files in os.walk(extract_path):\n",
        "    for file in files:\n",
        "        if file.endswith(('.fasta', '.fa', '.gbk', '.gb', '.txt')):\n",
        "            bio_files.append(os.path.join(root, file))\n",
        "\n",
        "print(f\"Fichiers potentiels trouvés : {bio_files}\\n\")\n",
        "\n",
        "if bio_files:\n",
        "    # Exemple de lecture d'une séquence avec Biopython si un fichier texte/fasta est présent\n",
        "    try:\n",
        "        for file_path in bio_files[:2]:\n",
        "            print(f\"--- Tentative de lecture de : {os.path.basename(file_path)} ---\")\n",
        "            with open(file_path, 'r') as f:\n",
        "                content = f.read(500) # Lire les 500 premiers caractères\n",
        "                print(\"Aperçu du contenu brut :\")\n",
        "                print(content[:200])\n",
        "\n",
        "                # Exemple de manipulation avec Biopython\n",
        "                if \">\" in content: # Format FASTA probable\n",
        "                    for record in SeqIO.parse(file_path, \"fasta\"):\n",
        "                        print(f\"ID de la séquence : {record.id}\")\n",
        "                        print(f\"Longueur de la séquence : {len(record.seq)}\")\n",
        "                        print(f\"Traduction protéique (10 premiers AA) : {record.seq.translate()[:10]}\\n\")\n",
        "                        break\n",
        "    except Exception as e:\n",
        "        print(f\"Une erreur est survenue lors de l'analyse biologique : {e}\")\n",
        "else:\n",
        "    print(\"Aucun fichier de séquence biologique classique n'a été identifié directement.\")"
      ],
