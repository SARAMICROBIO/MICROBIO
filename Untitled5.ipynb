        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier\n",
        "from sklearn.linear_model import LinearRegression, LogisticRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score, accuracy_score, classification_report\n",
        "\n",
        "# Encoder les variables catégorielles en valeurs numériques pour l'entraînement\n",
        "X_train_encoded = pd.get_dummies(X_train, drop_first=True)\n",
        "X_test_encoded = pd.get_dummies(X_test, drop_first=True)\n",
        "\n",
        "# Aligner les colonnes d'entraînement et de test pour s'assurer qu'elles ont les mêmes colonnes après encodage\n",
        "X_train_encoded, X_test_encoded = X_train_encoded.align(X_test_encoded, join='left', axis=1, fill_value=0)\n",
        "\n",
        "# Gérer d'éventuelles valeurs manquantes restantes\n",
        "X_train_encoded = X_train_encoded.fillna(0)\n",
        "X_test_encoded = X_test_encoded.fillna(0)\n",
        "\n",
        "# Détecter si le problème est de la régression ou de la classification\n",
        "is_classification = y.nunique() < 10 or y.dtype == 'object'\n",
        "\n",
        "if is_classification:\n",
        "    print(\"--- Problème détecté : Classification ---\")\n",
        "    # Modèle 1: Régression Logistique\n",
        "    model_lr = LogisticRegression(max_iter=1000)\n",
        "    model_lr.fit(X_train_encoded, y_train)\n",
        "    preds_lr = model_lr.predict(X_test_encoded)\n",
        "\n",
        "    # Modèle 2: Forêt Aléatoire\n",
        "    model_rf = RandomForestClassifier(random_state=42)\n",
        "    model_rf.fit(X_train_encoded, y_train)\n",
        "    preds_rf = model_rf.predict(X_test_encoded)\n",
        "\n",
        "    print(\"\\n1. Résultats Régression Logistique :\")\n",
        "    print(f\"Précision (Accuracy) : {accuracy_score(y_test, preds_lr):.4f}\")\n",
        "\n",
        "    print(\"\\n2. Résultats Forêt Aléatoire (Random Forest) :\")\n",
        "    print(f\"Précision (Accuracy) : {accuracy_score(y_test, preds_rf):.4f}\")\n",
        "    print(\"\\nRapport de classification détaillé (Forêt Aléatoire) :\\n\", classification_report(y_test, preds_rf))\n",
        "else:\n",
        "    print(\"--- Problème détecté : Régression ---\")\n",
        "    # Modèle 1: Régression Linéaire\n",
        "    model_lr = LinearRegression()\n",
        "    model_lr.fit(X_train_encoded, y_train)\n",
        "    preds_lr = model_lr.predict(X_test_encoded)\n",
        "\n",
        "    # Modèle 2: Forêt Aléatoire\n",
        "    model_rf = RandomForestRegressor(random_state=42)\n",
        "    model_rf.fit(X_train_encoded, y_train)\n",
        "    preds_rf = model_rf.predict(X_test_encoded)\n",
        "\n",
        "    print(\"\\n1. Résultats Régression Linéaire :\")\n",
        "    print(f\"R² Score : {r2_score(y_test, preds_lr):.4f}\")\n",
        "    print(f\"RMSE (Erreur quadratique moyenne) : {np.sqrt(mean_squared_error(y_test, preds_lr)):.4f}\")\n",
        "\n",
        "    print(\"\\n2. Résultats Forêt Aléatoire (Random Forest) :\")\n",
        "    print(f\"R² Score : {r2_score(y_test, preds_rf):.4f}\")\n",
        "    print(f\"RMSE (Erreur quadratique moyenne) : {np.sqrt(mean_squared_error(y_test, preds_rf)):.4f}\")"
      ],
