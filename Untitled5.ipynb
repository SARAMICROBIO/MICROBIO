        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Nous supposons que vous avez déjà chargé vos variables explicatives (X) et votre cible (Y)\n",
        "# Remplacer 'target_column' par le nom de votre colonne cible\n",
        "target_column = df.select_dtypes(include=['number']).columns[-1] # Par défaut, la dernière colonne numérique\n",
        "\n",
        "X = df.drop(columns=[target_column])\n",
        "y = df[target_column]\n",
        "\n",
        "# Division des données : 75% entraînement, 25% test\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)\n",
        "\n",
        "print(\"=== Division des données (75% / 25%) ===\")\n",
        "print(f\"Taille globale du jeu de données : {df.shape[0]} lignes\")\n",
        "print(f\"Taille du jeu d'entraînement (X_train) : {X_train.shape[0]} lignes ({X_train.shape[0]/df.shape[0]:.1%})\")\n",
        "print(f\"Taille du jeu de test (X_test) : {X_test.shape[0]} lignes ({X_test.shape[0]/df.shape[0]:.1%})\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
